# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Resend only delivers to the address that owns the Resend account until you
# verify a domain, so onboarding@resend.dev works for you and nobody else.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RECUR_EMAIL_FROM=Recur <onboarding@resend.dev>

# Local development only. Production sets these in the Render dashboard.
# RECUR_ENV=development
# RECUR_REGISTRATION_OPEN=0
